{
  "version": 1,
  "schema_version": "2026.1",
  "description": "Catálogo declarativo de indicadores del dashboard Atlas GRO. Edite la copia canónica en Stack_Martin/config/indicators/catalog.json y sincronice aquí si no usa Docker.",
  "groups": [
    {
      "id": "socio",
      "label": "Sociodemografía",
      "order": 1
    },
    {
      "id": "viv",
      "label": "Vivienda",
      "order": 2
    },
    {
      "id": "eco",
      "label": "Economía",
      "order": 3
    },
    {
      "id": "gov",
      "label": "Gobierno",
      "order": 4
    },
    {
      "id": "geo",
      "label": "Geografía (indicadores tabulares)",
      "order": 5
    }
  ],
  "data_sources": {
    "tab_municipal": {
      "schema": "atlas",
      "table": "tab_municipal",
      "description": "Tabla ancha ETL: filas Nacional, Estatal y ~85 municipios (cve_mun 001–085).",
      "row_types": [
        "Nacional",
        "Estatal",
        "municipio_3digitos"
      ]
    },
    "tab_nacional": {
      "schema": "atlas",
      "table": "tab_nacional",
      "description": "Indicadores por entidad federativa (32) más filas nacional/estatal.",
      "row_types": [
        "entidad_01_32",
        "nacional",
        "estatal_guerrero"
      ]
    },
    "c_mun": {
      "schema": "atlas",
      "table": "c_mun",
      "description": "Marco municipal PostGIS; superficie comparativa.",
      "row_types": [
        "municipio_geometria"
      ]
    }
  },
  "indicators": [
    {
      "id": "socio_poblacion",
      "group_id": "socio",
      "label": "Población",
      "subtitle": "INEGI · Censos 2010 y 2020",
      "unit": "personas",
      "enabled": true,
      "migration_status": "studio",
      "source": {
        "primary_table": "atlas.tab_municipal",
        "scope": "studio"
      },
      "fields": [
        {
          "key": "pob_tot",
          "column": "pob_tot",
          "column_aliases": [
            "pop_tot",
            "POP_TOT"
          ],
          "label": "Población 2020",
          "type": "integer",
          "source_table": "tab_municipal"
        },
        {
          "key": "pob_tot_2010",
          "column": "pob_tot_2010",
          "column_aliases": [
            "POB_TOT_2010"
          ],
          "label": "Población 2010",
          "type": "integer",
          "source_table": "tab_municipal"
        }
      ],
      "presentation": {
        "template": "ranking_dual_bars",
        "sort_by": "pob_tot",
        "sections": [
          "top5",
          "middle",
          "bottom5"
        ],
        "bar_metrics": [
          "pob_tot_2010",
          "pob_tot"
        ],
        "legend_labels": [
          "2010",
          "2020"
        ],
        "title": "Población total por municipios seleccionados 2010 y 2020",
        "root_class": "poblacion-viz",
        "footer": "Fuente: INEGI. Censos de Población y Vivienda 2010 y 2020. Tabulados del cuestionario básico. Población 2.",
        "ranking": true,
        "style": {
          "colors": {
            "claro": {
              "series": [
                "#6342ff",
                "#d08200"
              ],
              "serie1": "#6342ff",
              "serie2": "#d08200"
            },
            "oscuro": {
              "series": [
                "#1a4971",
                "#3dbdbd"
              ],
              "serie1": "#1a4971",
              "serie2": "#3dbdbd"
            }
          }
        }
      },
      "metadata": {
        "enabled": true,
        "title": "Población",
        "periodicidad": "Quinquenal",
        "unidad_medida": "Personas",
        "fuente": "2020 Censos y Conteos de Población y Vivienda",
        "nota_general": "Esta información se actualiza cada cinco años mediante los Censos y Conteos de población y vivienda.",
        "notas": [
          {
            "periodo": "2010",
            "texto": "La información es censal y está referida al 12 de junio de 2010."
          },
          {
            "periodo": "2020",
            "texto": "La información es censal y está referida al 12 de marzo de 2020."
          }
        ],
        "fecha_inicial": "1910",
        "fecha_final": "2020",
        "ultima_actualizacion": "21/10/2024"
      },
      "api": {
        "path": "/api/indicators/socio_poblacion",
        "legacy_paths": [
          "/api/comparativas/poblacion",
          "/api/poblacion_comparativa.php"
        ],
        "params": [
          "cve_mun",
          "nom_mun"
        ],
        "response_profile": "ranking_municipal"
      },
      "export": {
        "filename_prefix": "poblacion",
        "formats": [
          "png",
          "csv",
          "xlsx"
        ],
        "target_selector": ".poblacion-viz",
        "csv_columns": [
          "seccion",
          "cve_mun",
          "nom_mun",
          "pob_tot_2010",
          "pob_tot"
        ],
        "footer": "Fuente: INEGI. Censos de Población y Vivienda 2010 y 2020. Tabulados del cuestionario básico. Población 2."
      },
      "legacy": {
        "menu_flag": "poblacionComparativa"
      }
    },
    {
      "id": "socio_crecimiento",
      "group_id": "socio",
      "label": "Población y crecimiento",
