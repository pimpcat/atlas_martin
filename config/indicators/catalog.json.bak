          "column_aliases": [
            "CRECI_10_20",
            "pcreci_10_20",
            "PCRECI_10_20"
          ]
        }
      ],
      "presentation": {
        "template": "ranking_with_rates_table",
        "sort_by": "dist_porc",
        "sections": [
          "top5",
          "middle",
          "bottom5"
        ],
        "bar_metrics": [
          "dist_porc"
        ],
        "title": "Distribución porcentual de población y tasa de crecimiento anual por municipios seleccionados 2020",
        "footer": "Fuente: INEGI. Censos de Población y Vivienda 2000, 2010 y 2020. Tabulados del cuestionario básico. Población 2.",
        "style": {
          "colors": {
            "claro": {
              "barra": "#5b8def",
              "barra_hl": "#0d8a8a"
            },
            "oscuro": {
              "barra": "#5b8def",
              "barra_hl": "#2dbdb5"
            }
          }
        },
        "table_metrics": [
          "creci_00_10",
          "creci_10_20"
        ],
        "table_title": "Tasa de crecimiento"
      },
      "metadata": {
        "enabled": true,
        "title": "Población y crecimiento",
        "periodicidad": "Quinquenal",
        "unidad_medida": "%",
        "fuente": "INEGI. Censos de Población y Vivienda 2000, 2010 y 2020. Tabulados del cuestionario básico. Población 2.",
        "nota_general": "Esta información se actualiza cada cinco años mediante los Censos y Conteos de población y vivienda.",
        "notas": [
          {
            "periodo": "2000",
            "texto": "La información es censal y está referida al 14 de febrero del 2000."
          },
          {
            "periodo": "2010",
            "texto": "La información es censal y está referida al 12 de junio de 2010."
          }
        ],
        "fecha_inicial": "1910",
        "fecha_final": "2020",
        "ultima_actualizacion": "21/10/2024"
      },
      "api": {
        "path": "/api/indicators/socio_crecimiento",
        "params": [
          "cve_mun",
          "nom_mun"
        ],
        "response_profile": "ranking_municipal",
        "legacy_paths": [
          "/api/crecimiento_comparativa.php"
        ]
      },
      "export": {
        "filename_prefix": "crecimiento",
        "formats": [
          "png",
          "csv",
          "xlsx"
        ],
        "target_selector": ".crecimiento-viz",
        "footer": "Fuente: INEGI. Censos de Población y Vivienda 2000, 2010 y 2020. Tabulados del cuestionario básico. Población 2.",
        "csv_columns": [
