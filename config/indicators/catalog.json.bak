      "id": "gov_habitantes_por_policia",
      "group_id": "gov",
      "label": "Habitantes por policía",
      "subtitle": "CNGG 2022 · habitantes por policía preventiva",
      "unit": "",
      "enabled": true,
      "migration_status": "phase6",
      "source": {
        "primary_table": "atlas.tab_municipal",
        "scope": "municipal_ranking"
      },
      "fields": [
        {
          "key": "habxpol",
          "column": "habxpol",
          "label": "Habitantes por policía",
          "type": "float",
          "source_table": "tab_municipal"
        },
        {
          "key": "pob_tot",
          "column": "pob_tot",
          "column_aliases": [
            "pop_tot"
          ],
          "label": "Población total",
          "type": "integer",
          "source_table": "tab_municipal"
        },
        {
          "key": "pol_prev",
          "column": "pol_prev",
          "label": "Policías preventivos",
          "type": "integer",
          "source_table": "tab_municipal"
        }
      ],
      "computed_fields": [
        {
          "key": "habxpol_eff",
          "description": "Fallback runtime si habxpol es NULL; ETL debe poblar habxpol siempre",
          "formula": "pop_tot / pol_prev",
          "migrate_to_etl": true,
          "etl_column_proposal": "habxpol"
        }
      ],
      "presentation": {
        "template": "ranking_with_rates_table",
        "sort_by": "habxpol",
        "sections": [
          "top5",
          "middle",
          "bottom5"
        ],
        "bar_metrics": [
          "habxpol"
        ],
        "table_metrics": [
          "pob_tot",
          "pol_prev"
        ],
        "table_title": "Población y policías",
        "title": "Número de habitantes por policía en municipios seleccionados 2022",
        "footer": "Fuente: INEGI. Censo Nacional de Gobiernos Municipales y Demarcaciones Territoriales de la Ciudad de México 2023. Datos Abiertos. Censo de Población y Vivienda 2020. Tabulados del cuestionario básico."
      },
